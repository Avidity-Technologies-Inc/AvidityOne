{
  "name": "avidity-it-management-tool",
  "private": true,
  "version": "0.1.0",
  "description": "Modular IT management platform for MSP and internal IT operations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @avidity/api run start:dev",
    "dev:web": "npm --workspace @avidity/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @avidity/shared run build && npm --workspace @avidity/config run build && npm --workspace @avidity/ui run build",
    "build:api": "npm --workspace @avidity/api run build",
    "build:web": "npm --workspace @avidity/web run build",
    "lint": "npm-run-all lint:api lint:web",
    "lint:api": "npm --workspace @avidity/api run lint",
    "lint:web": "npm --workspace @avidity/web run lint",
    "test": "npm --workspace @avidity/api run test",
    "test:browser": "playwright test",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.1",
    "dotenv": "^16.4.5",
    "npm-run-all": "^4.1.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1",
    "sharp": "0.35.5",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "next": {
      "postcss": "8.5.23"
    },
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    },
    "@nestjs/cli": {
      "webpack": "5.107.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0",
    "js-yaml@^3.13.1": "3.15.2",
    "js-yaml@^4.1.0": "4.3.2",
    "fast-uri": "3.1.8",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "nanoid@^3.3.11": "3.3.18",
    "shell-quote": "1.11.0",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "handlebars": "4.7.10"
  },
  "dependencies": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
